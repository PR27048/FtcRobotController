@Disabled
public class ServoPosOpmode extends OpMode {
    ServoPosCode bench = new ServoPosCode();

    @Override
    public void init() {
        bench.init(hardwareMap);
    }
    @Override
    public void loop() {
        if (gamepad1.a) {
            bench.setServoPos(-1.0);
        } else {
            bench.setServoPos(1.0);
        }

